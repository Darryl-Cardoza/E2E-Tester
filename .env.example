# Optional: copy to .env. Existing shell variables take precedence.
TEST_ENV=local-demo
BROWSER=chromium
# Backend path prefixes when frontend and API share an origin.
API_PATH_PREFIXES=/api
# Required together for development/staging; comma-separated exact URL hosts.
# FRONTEND_BASE_URL=https://app.dev.example.test
# API_BASE_URL=https://api.dev.example.test
# ALLOWED_TARGET_HOSTS=app.dev.example.test,api.dev.example.test
# WORKERS=2
# RETRIES=0
# TEST_TIMEOUT_MS=30000
# REQUEST_TIMEOUT_MS=15000
# TEST_EMAIL=
# TEST_PASSWORD=
# TEST_USER_TOKEN=
# TEST_ADMIN_TOKEN=
# TEST_EXPIRED_TOKEN=
# TEST_SESSION_LOGIN_PATH=/api/login
# Environment-scoped credentials override unprefixed values for that environment:
# STAGING_TEST_USER_TOKEN=
# APP_BUILD_ID=
